pipeline {
  agent any

  environment {
    CI = 'true'
    DOCKER_HOST = 'tcp://172.19.0.3:2375'
    DOCKER_TLS_VERIFY = ''
    DOCKER_CERT_PATH = ''
  }

  stages {
    stage('Build') {
      steps {
        sh '''
          docker run --rm \
            -e CI=true \
            -v "$PWD:/app" -w /app \
            node:lts-buster-slim \
            bash -lc "npm install"
        '''
      }
    }

    stage('Test') {
      steps {
        sh '''
          docker run --rm \
            -e CI=true \
            -v "$PWD:/app" -w /app \
            node:lts-buster-slim \
            bash -lc "./jenkins/scripts/test.sh"
        '''
      }
    }

    stage('Manual Approval') {
      steps {
        script {
          input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
        }
      }
    }

    stage('Deploy') {
      steps {
        sh './jenkins/scripts/deliver.sh'
        sh 'sleep 60'
        sh './jenkins/scripts/kill.sh'
      }
    }
  }
}
