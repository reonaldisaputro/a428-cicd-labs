pipeline {
  agent any

  environment {
    CI = 'true'
    DOCKER_HOST = 'tcp://172.19.0.3:2375'
  }

  stages {
    stage('Build') {
      steps {
        sh '''
          env -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH -u DOCKER_TLS_CERTDIR \
          docker run --rm \
            -e CI=true \
            -v "$PWD:/app" -w /app \
            node:lts-buster-slim \
            bash -lc "npm install"
        '''
      }
    }

    stage('Test') {
      steps {
        sh '''
          env -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH -u DOCKER_TLS_CERTDIR \
          docker run --rm \
            -e CI=true \
            -v "$PWD:/app" -w /app \
            node:lts-buster-slim \
            bash -lc "./jenkins/scripts/test.sh"
        '''
      }
    }

    stage('Manual Approval') {
      steps {
        script {
          input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
        }
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          env -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH -u DOCKER_TLS_CERTDIR \
          ./jenkins/scripts/deliver.sh

          sleep 60

          env -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH -u DOCKER_TLS_CERTDIR \
          ./jenkins/scripts/kill.sh
        '''
      }
    }
  }
}
