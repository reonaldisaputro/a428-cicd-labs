pipeline {
  agent {
    docker {
      image 'node:lts-buster-slim'
      // port exposure tetap, tapi ingat: publish port dari container agent Jenkins
      args '-p 3000:3000'
    }
  }

  environment {
    CI = 'true'
  }

  stages {
    stage('Build') {
      steps {
        sh 'npm install'
      }
    }

    stage('Test') {
      steps {
        sh './jenkins/scripts/test.sh'
      }
    }

    stage('Manual Approval') {
      steps {
        // Kriteria 4: teks wajib seperti ini
        input message: 'Lanjutkan ke tahap Deploy?'
      }
    }

    stage('Deploy') {
      steps {
        // Deploy/jalankan aplikasi
        sh './jenkins/scripts/deliver.sh'

        // Kriteria 3: jeda 1 menit tanpa input manual
        sh 'sleep 60'

        // Setelah 1 menit, hentikan aplikasi agar pipeline sukses
        sh './jenkins/scripts/kill.sh'
      }
    }
  }
}
