pipeline {
  agent any

  environment {
    CI = 'true'
    DOCKER_HOST = 'tcp://172.19.0.3:2375'
  }

  stages {
    stage('Build') {
      steps {
        sh '''
          env -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH -u DOCKER_TLS_CERTDIR \
          tar -czf - . | \
          docker run --rm -i \
            -e CI=true \
            -w /work \
            node:lts-buster-slim \
            bash -lc "mkdir -p /work && tar -xzf - -C /work && npm install"
        '''
      }
    }

    stage('Test') {
      steps {
        sh '''
          env -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH -u DOCKER_TLS_CERTDIR \
          tar -czf - . | \
          docker run --rm -i \
            -e CI=true \
            -w /work \
            node:lts-buster-slim \
            bash -lc "mkdir -p /work && tar -xzf - -C /work && CI=true npm test -- --watchAll=false"
        '''
      }
    }

    stage('Manual Approval') {
      steps {
        script {
          input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
        }
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          env -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH -u DOCKER_TLS_CERTDIR \
          ./jenkins/scripts/deliver.sh

          sleep 60

          env -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH -u DOCKER_TLS_CERTDIR \
          ./jenkins/scripts/kill.sh
        '''
      }
    }
  }
}
