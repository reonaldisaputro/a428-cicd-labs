pipeline {
  agent none

  environment {
    CI = 'true'
    // Docker-in-Docker untuk DEPLOY saja
    DOCKER_HOST = 'tcp://172.19.0.3:2375'
  }

  stages {
    stage('Build') {
      agent { docker { image 'node:lts-buster-slim' } }
      steps {
        sh 'npm install'
      }
    }

    stage('Test') {
      agent { docker { image 'node:lts-buster-slim' } }
      steps {
        sh 'CI=true npm test -- --watchAll=false'
      }
    }

    stage('Manual Approval') {
      agent any
      steps {
        script {
          input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
        }
      }
    }

    stage('Deploy') {
      agent any
      steps {
        sh '''
          # paksa non-TLS agar docker tidak mencoba HTTPS
          unset DOCKER_TLS_VERIFY DOCKER_CERT_PATH DOCKER_TLS_CERTDIR

          ./jenkins/scripts/deliver.sh
          sleep 60
          ./jenkins/scripts/kill.sh
        '''
      }
    }
  }
}
