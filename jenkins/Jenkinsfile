pipeline {
  agent any

  environment {
    CI = 'true'
    HOST_WS = '/home/dzikri/jenkins_home/workspace/react-app'  // path host (sesuai bind mount)
  }

  stages {
    stage('Build') {
      steps {
        sh '''
          docker run --rm \
            -e CI=true \
            -v "$HOST_WS:/work" -w /work \
            node:lts-buster-slim \
            bash -lc "npm install"
        '''
      }
    }

    stage('Test') {
      steps {
        sh '''
          docker run --rm \
            -e CI=true \
            -v "$HOST_WS:/work" -w /work \
            node:lts-buster-slim \
            bash -lc "CI=true npm test -- --watchAll=false"
        '''
      }
    }

    stage('Manual Approval') {
      steps {
        script {
          input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
        }
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          ./jenkins/scripts/deliver.sh
          sleep 60
          ./jenkins/scripts/kill.sh
        '''
      }
    }
  }
}
